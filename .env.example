# Copy to .env and fill in. Never commit .env.
ENV=dev
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Stratum's own project (London). SUPABASE_ANON_KEY holds the PUBLISHABLE key
# (sb_publishable_..., Settings > API Keys); it is served to the browser by /api/config.
# No secret key here: the API never holds a credential that can read across agencies.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The secret key and the signing key do NOT go here. Only the queue worker uses them,
# and they live in .env.worker (gitignored):
#   SUPABASE_URL=...                same as above
#   SUPABASE_ANON_KEY=...           same publishable key as above
#   SUPABASE_SERVICE_ROLE_KEY=...   a SECRET key (sb_secret_...): claims and settles jobs
#                                   (queue/ledger.py)
#   SUPABASE_JWT_PRIVATE_KEY=...    signs a token for each job's requester
#                                   (queue/identity.py; make it with --new-key)
# The API removes the service-role key from its own environment at startup if it
# finds it. Rotating any of these: docs/runbooks/rotate-secrets.md
# AI providers (add as modules need them)
OPENROUTER_API_KEY=
FAL_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region: https://cloud.langfuse.com  |  US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
SENTRY_DSN=

# The shared demo behind "Try the demo" on the sign-in page (API only; optional). A
# separate Supabase user in its own agency with fictional clients - never the real one.
# The password stays on the server; the browser only gets that account's session.
DEMO_EMAIL=
DEMO_PASSWORD=
