# Copy to .env and fill in. Never commit .env.
ENV=dev
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Stratum's own project (London). The ANON key is publishable and is served to
# the browser by /api/config. The SERVICE ROLE key is deliberately NOT used: the
# API never holds a credential that can read across agencies.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The service-role key and the JWT secret do NOT go here. Only the queue worker uses
# them, and they live in .env.worker (gitignored):
#   SUPABASE_URL=...               same as above
#   SUPABASE_ANON_KEY=...          same publishable key as above
#   SUPABASE_SERVICE_ROLE_KEY=...  claims and settles jobs (queue/ledger.py)
#   SUPABASE_JWT_SECRET=...        signs a token for each job's requester (queue/identity.py)
# The API removes the service-role key from its own environment at startup if it
# finds it.
# AI providers (add as modules need them)
OPENROUTER_API_KEY=
FAL_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region: https://cloud.langfuse.com  |  US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
SENTRY_DSN=
