{
  "name": "@stratum/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stratum's editor: the poster canvas, built into static files the API serves at /app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "prettier --check src && tsc --noEmit && vitest run && vite build",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.103.3",
    "dompurify": "3.4.16",
    "lucide-react": "1.48.0",
    "motion": "13.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.1.1",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.2"
  }
}
